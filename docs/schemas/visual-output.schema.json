{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-output.schema.json",
  "title": "VisualOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["components", "rationale"],
  "properties": {
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/VisualComponent" }
    },
    "rationale": { "type": "string" }
  },
  "$defs": {
    "VisualComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "props"],
      "properties": {
        "type": { "type": "string" },
        "props": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "heading" } } },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" },
                  "level": { "type": "integer", "minimum": 1, "maximum": 6 },
                  "schema_version": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "paragraph" } } },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string" },
                  "schema_version": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "bullets" } } },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["items"],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "ordered": { "type": "boolean" },
                  "schema_version": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "callout" } } },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "text": { "type": "string" },
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "tone": { "type": "string", "enum": ["note", "info", "warning"] },
                  "schema_version": { "type": "string" }
                },
                "anyOf": [
                  { "required": ["text"] },
                  { "required": ["items"] }
                ],
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "list" } } },
          "then": {
            "properties": {
              "props": {
                "type": "object",
                "required": ["items"],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "title": { "type": "string" },
                  "schema_version": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ]
    }
  }
}
