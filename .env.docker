# Docker Infrastructure Environment Variables
# Copy this file to .env and configure as needed

# =============================================================================
# GraphDB Configuration
# =============================================================================
GRAPHDB_HOST=localhost
GRAPHDB_PORT=7200
GRAPHDB_REPOSITORY=researcher
GRAPHDB_SPARQL_ENDPOINT=http://localhost:7200/repositories/researcher

# GraphDB Admin (optional, for programmatic repo creation)
# GRAPHDB_ADMIN_USER=admin
# GRAPHDB_ADMIN_PASSWORD=admin

# =============================================================================
# Qdrant Configuration
# =============================================================================
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333

# Collection settings
QDRANT_COLLECTION_NAME=papers
QDRANT_VECTOR_SIZE=1536  # OpenAI text-embedding-3-small

# =============================================================================
# OpenAI Configuration (for embeddings)
# =============================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Application Settings
# =============================================================================
ARTIFACTS_DIR=artifacts
LOG_LEVEL=INFO
