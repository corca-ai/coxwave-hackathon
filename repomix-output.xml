        ("paper:cl_xyz", "https://kg.corca.ai/paper#cl_xyz"),
        ("paper:pa_123", "https://kg.corca.ai/paper#pa_123"),
        ("https://kg.corca.ai/paper#co_abc", "https://kg.corca.ai/paper#co_abc"),
        ("https://example.org/other", "https://example.org/other"),
